{
  "name": "mishmaat-ishit",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "description": "משמעת אישית — weekly habit & weight tracker PWA (Hebrew, RTL, offline)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:artifact": "vite build --mode artifact && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "axe-core": "^4.10.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4"
  }
}
